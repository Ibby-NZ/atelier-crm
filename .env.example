# atelier-crm environment
# Base URL of atelier-api (the JSON API the CRM reads/writes).
VITE_API_BASE_URL=http://localhost:3001

# --- Break-glass (emergency) sign-in ----------------------------------------
# Optional, and OFF unless BOTH of the first two are set: an unconfigured build
# has no bypass at all. Read the header of src/auth/breakGlass.js before setting
# these — the summary is:
#
#   * It signs you into the CRM SHELL when atelier-api cannot be reached. The
#     demo/localStorage screens keep working; live data (clients, orders, stock,
#     price lists) does not, because this credential carries no API privilege
#     and every /admin/* call still needs the API's own cookie.
#   * BUILD TIME. Vite inlines these, so changing one needs a rebuild — and the
#     digest below ships PUBLICLY inside the JavaScript bundle.
#   * Therefore the passphrase must be LONG AND RANDOM (four random words plus
#     digits, or better). Never a human-chosen password, never one reused
#     anywhere else.
#   * Rotate by changing the value and rebuilding; live offline sessions are
#     invalidated automatically.
#
# The digest is a plain SHA-256 of the passphrase:
#   node -e 'console.log(require("crypto").createHash("sha256").update(process.argv[1]).digest("hex"))' '<passphrase>'
VITE_BREAKGLASS_EMAIL=
VITE_BREAKGLASS_PASSWORD_SHA256=
# Display name for that session in the CRM chrome. Defaults to "Offline access".
# VITE_BREAKGLASS_NAME=Offline access
